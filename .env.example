# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquicantabolivia?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="aquicantabolivia"

# Backend API Configuration
PORT=4000
NODE_ENV=development

# Autenticación del panel de administración — cambia JWT_SECRET por un valor
# propio en cada entorno (ej. `openssl rand -hex 32`), nunca reutilices este.
JWT_SECRET="reemplaza-esto-con-un-secreto-largo-y-aleatorio"

# Usuario admin que crea `bun run db:seed` (solo si no existe todavía).
ADMIN_EMAIL="admin@aquicantabolivia.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Frontend Web Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT_WEB=3000

# Login con Google para visitantes (Sellos, Butacas) — credenciales de un
# OAuth Client ID "Web application" en Google Cloud Console.
GOOGLE_CLIENT_ID="reemplaza-esto"
GOOGLE_CLIENT_SECRET="reemplaza-esto"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"
# Secreto propio del JWT de visitantes — distinto de JWT_SECRET (ver arriba),
# genera el tuyo con `openssl rand -hex 32`, nunca reutilices este.
VISITOR_JWT_SECRET="reemplaza-esto-con-otro-secreto-largo-y-aleatorio"
# A dónde redirige la API al frontend después del login con Google.
FRONTEND_URL="http://localhost:3000"

# Cloudinary (fotos del carnet de identidad en Inscripciones) — Dashboard →
# https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="reemplaza-esto"
CLOUDINARY_API_KEY="reemplaza-esto"
CLOUDINARY_API_SECRET="reemplaza-esto"

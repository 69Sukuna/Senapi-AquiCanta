# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquicantabolivia?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="aquicantabolivia"

# Backend API Configuration
PORT=4000
NODE_ENV=development

# Autenticación del panel de administración — cambia JWT_SECRET por un valor
# propio en cada entorno (ej. `openssl rand -hex 32`), nunca reutilices este.
JWT_SECRET="reemplaza-esto-con-un-secreto-largo-y-aleatorio"

# Usuario admin que crea `bun run db:seed` (solo si no existe todavía).
ADMIN_EMAIL="admin@aquicantabolivia.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Frontend Web Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT_WEB=3000

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ARTIST
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artistProfile ArtistProfile?

  @@map("users")
}

model ArtistProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageName String
  bio       String?
  genre     String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs Song[]

  @@map("artist_profiles")
}

model Categoria {
  id     String @id @default(uuid())
  nombre String @unique

  cantantes Cantante[]
  grupos    Grupo[]

  @@map("categorias")
}

model Cantante {
  id          String    @id @default(uuid())
  nombre      String
  fotoUrl     String?
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@map("cantantes")
}

model Grupo {
  id          String            @id @default(uuid())
  nombre      String
  fotoUrl     String?
  categoriaId String
  categoria   Categoria         @relation(fields: [categoriaId], references: [id])
  integrantes GrupoIntegrante[]

  @@map("grupos")
}

model GrupoIntegrante {
  id               String  @id @default(uuid())
  grupoId          String
  grupo            Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre           String
  nombreReferencia String?
  instrumento      String?
  fotoUrl          String?

  @@map("grupo_integrantes")
}

model Song {
  id          String         @id @default(uuid())
  title       String
  genre       String?
  durationSec Int?
  audioUrl    String?
  artistId    String
  artist      ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("songs")
}

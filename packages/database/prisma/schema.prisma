datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ARTIST
  ADMIN
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  // Único además de email — el login del panel admin acepta cualquiera de
  // los dos como identificador (ver AuthService.validarUsuario).
  username String? @unique
  // Hash bcrypt, nunca el password en texto plano.
  password String
  name     String?
  role     Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artistProfile ArtistProfile?

  @@map("users")
}

// Identidad de los visitantes que se loguean con Google (Sellos, Butacas) —
// a propósito NO es lo mismo que `User` (esa es del panel admin/artistas).
// Sin `password` ni `role`: no hay ningún campo de privilegio que escalar,
// y el JWT de un visitante se firma con un secreto distinto al de `User`
// (ver VisitanteJwtStrategy), así que un token nunca sirve para el otro.
model Visitante {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visitantes")
}

model ArtistProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageName String
  bio       String?
  genre     String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs Song[]

  @@map("artist_profiles")
}

enum Departamento {
  LA_PAZ
  COCHABAMBA
  SANTA_CRUZ
  ORURO
  POTOSI
  CHUQUISACA
  TARIJA
  BENI
  PANDO
}

enum EstadoInscripcion {
  SIN_CONFIRMAR
  PRESELECCION
  PARTICIPANTE_FINAL
  RECHAZADO
}

model Categoria {
  id     String @id @default(uuid())
  nombre String @unique

  // Límites de la convocatoria oficial. Si integrantesMax > 1, la
  // postulación crea un Grupo; si no, crea un Cantante (ya no se guarda un
  // booleano esGrupal aparte, para que no se pueda desincronizar).
  integrantesMin Int @default(1)
  integrantesMax Int @default(1)
  // Máximo de músicos de acompañamiento permitidos (solo aplica a
  // categorías individuales — ninguna categoría grupal admite acompañantes).
  acompanantesMax Int @default(0)
  // Rango de edad exigido por la convocatoria, en años, al 10-sep-2026
  // (ej. Ñusta: 16-25, infantiles: hasta 12). Null = sin restricción.
  edadMinima Int?
  edadMaxima Int?
  // Duración máxima del tema, en minutos, para la etapa de preselección
  // (la mayoría son 5; Estudiantina/Autóctono 7; Ñusta 10).
  duracionMaximaMinutos Float @default(5)
  // Categorías infantiles: la convocatoria exige nombre y C.I. de un adulto
  // responsable (padre, madre o tutor legal) del postulante.
  requiereAdultoResponsable Boolean @default(false)

  cantantes Cantante[]
  grupos    Grupo[]

  @@map("categorias")
}

model Cantante {
  id              String        @id @default(uuid())
  nombre          String
  // Del Anexo 1 (Ficha de Postulación) — datos principales del postulante.
  pseudonimo      String? // solo aplica a la categoría "Composición"
  tituloTema      String?
  autorCompositor String?
  ritmo           String?
  tiempo          String? // duración de la interpretación, en minutos (ej. "3:30")
  departamento    Departamento?
  fotoUrl         String?
  // Enlace (YouTube, Drive, etc.) al video de la interpretación, subido por
  // el postulante en el formulario de inscripciones.
  videoUrl        String?
  categoriaId     String
  categoria       Categoria     @relation(fields: [categoriaId], references: [id])

  // Datos personales/de contacto — privados, nunca se exponen en endpoints
  // públicos. Del Anexo 1 (tabla de firmas) y Anexo 2 (carta de presentación).
  ciNumero              String?
  ciExtension           String?
  fechaNacimiento       DateTime?
  whatsapp              String?
  direccion             String?
  celular1              String?
  celular2              String?
  aceptaBases           Boolean           @default(false)
  declaracionVoluntaria Boolean           @default(false)
  estado                EstadoInscripcion @default(SIN_CONFIRMAR)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt

  // Categorías infantiles: adulto responsable (padre, madre o tutor legal).
  // autorizaParticipacion es la aceptación digital de los términos del
  // Anexo 4 (carta de autorización de participación) — no hay una carta
  // firmada, pero sí debe quedar registrada la declaración.
  adultoResponsableNombre      String?
  adultoResponsableCiNumero    String?
  adultoResponsableCiExtension String?
  adultoResponsableCelular     String?
  autorizaParticipacionAdultoResponsable Boolean @default(false)

  // Foto del carnet de identidad (anverso/reverso) — privada, nunca se
  // expone en endpoints públicos. No confundir con fotoUrl (foto pública
  // de perfil del artista).
  fotoCiAnversoUrl String?
  fotoCiReversoUrl String?
  // Foto del carnet del adulto responsable — mismo criterio de privacidad.
  adultoResponsableFotoCiAnversoUrl String?
  adultoResponsableFotoCiReversoUrl String?

  // Solo categoría Ñusta: PDF del "plan de promoción del festival" que la
  // convocatoria exige presentar, a ejecutar en caso de resultar coronada.
  planPromocionUrl String?

  // Músicos de acompañamiento (categorías individuales que lo permiten).
  acompanantes Acompanante[]

  @@map("cantantes")
}

model Acompanante {
  id          String   @id @default(uuid())
  cantanteId  String
  cantante    Cantante @relation(fields: [cantanteId], references: [id], onDelete: Cascade)
  nombre      String
  ciNumero    String?
  ciExtension String?
  instrumento String?

  // Foto del carnet de identidad (anverso/reverso) — privada, nunca se
  // expone en endpoints públicos.
  fotoCiAnversoUrl String?
  fotoCiReversoUrl String?

  @@map("acompanantes")
}

model Grupo {
  id              String            @id @default(uuid())
  nombre          String
  pseudonimo      String?
  tituloTema      String?
  autorCompositor String?
  ritmo           String?
  tiempo          String?
  departamento    Departamento?
  fotoUrl         String?
  // Enlace (YouTube, Drive, etc.) al video de la interpretación, subido por
  // el postulante en el formulario de inscripciones.
  videoUrl        String?
  categoriaId     String
  categoria       Categoria         @relation(fields: [categoriaId], references: [id])
  integrantes     GrupoIntegrante[]

  // Datos de contacto del postulante — privados, nunca se exponen en
  // endpoints públicos.
  celular1              String?
  celular2              String?
  aceptaBases           Boolean           @default(false)
  declaracionVoluntaria Boolean           @default(false)
  estado                EstadoInscripcion @default(SIN_CONFIRMAR)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt

  // Alternativa a subir la foto del carnet integrante por integrante: un
  // representante sube una o varias fotos/PDFs con todos los carnets del
  // grupo juntos (pensado para categorías con muchos integrantes, ej.
  // Estudiantina/Autóctono, donde pedir anverso+reverso a cada uno es
  // demasiada carga para llenar desde el celular). Privado, nunca se
  // expone en endpoints públicos.
  fotosCarnetsGrupalUrls String[] @default([])

  @@map("grupos")
}

model GrupoIntegrante {
  id               String  @id @default(uuid())
  grupoId          String
  grupo            Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre           String
  nombreReferencia String?
  instrumento      String?
  fotoUrl          String?

  // Datos personales — privados, nunca se exponen en endpoints públicos.
  ciNumero        String?
  ciExtension     String?
  fechaNacimiento DateTime?
  whatsapp        String?
  direccion       String?

  // Foto del carnet de identidad (anverso/reverso) — privada, nunca se
  // expone en endpoints públicos.
  fotoCiAnversoUrl String?
  fotoCiReversoUrl String?

  @@map("grupo_integrantes")
}

// Interruptor por vista pública (Inscripciones, Votaciones, Butacas, etc.):
// el admin puede apagarla desde /adminpanel/vistas sin tocar código ni hacer
// un deploy — la página sigue existiendo, solo muestra un aviso de "cerrado"
// en vez de su contenido normal mientras activo = false. `clave` es el mismo
// segmento de ruta que usa ROUTES en el frontend (ej. "inscripciones",
// "realidad-virtual"), así una página solo necesita conocer su propia clave.
model ConfiguracionVista {
  id          String   @id @default(uuid())
  clave       String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("configuraciones_vista")
}

model Song {
  id          String         @id @default(uuid())
  title       String
  genre       String?
  durationSec Int?
  audioUrl    String?
  artistId    String
  artist      ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("songs")
}

// --- Sellos: pasaporte de sellos tipo scouts, genérico para varios eventos ---
// Trayecto > Evento > PuntoEscaneo (agrupados por `instancia` para permitir
// "recuperar" un evento en otra fecha/lugar) > EscaneoPunto (por visitante).
// Rango exige un conjunto específico de Eventos completados.

model Trayecto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  imagenUrl   String? // imagen representativa del trayecto, se muestra en su propia tarjeta
  activo      Boolean  @default(true)
  // Controla si la vista pública muestra la cantidad de visitantes distintos
  // que ya escanearon algún sello de este trayecto (el panel admin siempre
  // la ve, sin importar este valor).
  mostrarConteoVisitantes Boolean  @default(false)
  createdAt               DateTime @default(now())

  eventos Evento[]
  rangos  Rango[]

  @@map("trayectos")
}

model Evento {
  id         String   @id @default(uuid())
  trayectoId String
  trayecto   Trayecto @relation(fields: [trayectoId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)
  imagenUrl  String? // insignia al completar el evento

  puntos PuntoEscaneo[]
  rangos Rango[] // m:n implícito con Rango.eventos

  @@map("eventos")
}

model PuntoEscaneo {
  id        String  @id @default(uuid())
  eventoId  String
  evento    Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  // Etiqueta de la repetición del evento (ej. "Sábado" / "Domingo"). Puntos con
  // la misma etiqueta forman una ocurrencia; hay que escanearlos todos juntos
  // para completar el evento por esa vía. null = ocurrencia única sin repetición.
  instancia String?
  nombre    String?
  codigo    String  @unique // valor codificado en el QR/imagen físico
  imagenUrl String? // imagen que se revela al escanear este punto

  escaneos EscaneoPunto[]

  @@map("puntos_escaneo")
}

model EscaneoPunto {
  id          String       @id @default(uuid())
  // UUID anónimo generado en el navegador (aún no hay login); cuando exista,
  // este mismo campo puede recibir directamente el id del User.
  visitorId   String
  puntoId     String
  punto       PuntoEscaneo @relation(fields: [puntoId], references: [id], onDelete: Cascade)
  escaneadoEn DateTime     @default(now())

  @@unique([visitorId, puntoId])
  @@index([visitorId])
  @@map("escaneos_punto")
}

model Rango {
  id         String   @id @default(uuid())
  trayectoId String
  trayecto   Trayecto @relation(fields: [trayectoId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)

  eventos Evento[] // eventos que este rango exige completados

  @@map("rangos")
}

// Escalón de reconocimiento por CANTIDAD TOTAL de sellos escaneados por el
// visitante — sin importar de qué Trayecto vengan (a propósito: es un
// reconocimiento general, no del recorrido de un evento en particular).
// Por eso NO cuelga de ningún Trayecto — es una sola lista global, editable
// desde el panel de administración igual que ConfiguracionVista.
model Medalla {
  id          String @id @default(uuid())
  nombre      String // ej. "Aficionado"
  descripcion String // ej. "Consigue tu primer sello"
  umbral      Int // cantidad mínima de sellos escaneados para desbloquearla
  orden       Int      @default(0)
  imagenUrl   String? // arte de la medalla; null = usa el arte fijo por posición que ya tiene la vista de cliente

  @@map("medallas")
}

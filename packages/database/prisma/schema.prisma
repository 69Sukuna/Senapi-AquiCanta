datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ARTIST
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artistProfile ArtistProfile?

  @@map("users")
}

model ArtistProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageName String
  bio       String?
  genre     String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs Song[]

  @@map("artist_profiles")
}

enum Departamento {
  LA_PAZ
  COCHABAMBA
  SANTA_CRUZ
  ORURO
  POTOSI
  CHUQUISACA
  TARIJA
  BENI
  PANDO
}

enum EstadoInscripcion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Categoria {
  id       String  @id @default(uuid())
  nombre   String  @unique
  // Determina si una postulación a esta categoría crea un Cantante o un Grupo.
  esGrupal Boolean @default(false)

  cantantes Cantante[]
  grupos    Grupo[]

  @@map("categorias")
}

model Cantante {
  id              String        @id @default(uuid())
  nombre          String
  // Del Anexo 1 (Ficha de Postulación) — datos principales del postulante.
  pseudonimo      String? // solo aplica a la categoría "Composición"
  tituloTema      String?
  autorCompositor String?
  ritmo           String?
  tiempo          String? // duración de la interpretación, en minutos (ej. "3:30")
  departamento    Departamento?
  fotoUrl         String?
  categoriaId     String
  categoria       Categoria     @relation(fields: [categoriaId], references: [id])

  // Datos personales/de contacto — privados, nunca se exponen en endpoints
  // públicos. Del Anexo 1 (tabla de firmas) y Anexo 2 (carta de presentación).
  ciNumero              String?
  ciExtension           String?
  edad                  String?
  whatsapp              String?
  direccion             String?
  celular1              String?
  celular2              String?
  aceptaBases           Boolean           @default(false)
  declaracionVoluntaria Boolean           @default(false)
  estado                EstadoInscripcion @default(PENDIENTE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("cantantes")
}

model Grupo {
  id              String            @id @default(uuid())
  nombre          String
  pseudonimo      String?
  tituloTema      String?
  autorCompositor String?
  ritmo           String?
  tiempo          String?
  departamento    Departamento?
  fotoUrl         String?
  categoriaId     String
  categoria       Categoria         @relation(fields: [categoriaId], references: [id])
  integrantes     GrupoIntegrante[]

  // Datos de contacto del postulante — privados, nunca se exponen en
  // endpoints públicos.
  celular1              String?
  celular2              String?
  aceptaBases           Boolean           @default(false)
  declaracionVoluntaria Boolean           @default(false)
  estado                EstadoInscripcion @default(PENDIENTE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("grupos")
}

model GrupoIntegrante {
  id               String  @id @default(uuid())
  grupoId          String
  grupo            Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre           String
  nombreReferencia String?
  instrumento      String?
  fotoUrl          String?

  // Datos personales — privados, nunca se exponen en endpoints públicos.
  ciNumero    String?
  ciExtension String?
  edad        String?
  whatsapp    String?
  direccion   String?

  @@map("grupo_integrantes")
}

model Song {
  id          String         @id @default(uuid())
  title       String
  genre       String?
  durationSec Int?
  audioUrl    String?
  artistId    String
  artist      ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("songs")
}
